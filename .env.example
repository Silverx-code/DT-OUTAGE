# Local development only. Use unique managed secrets in deployed environments.
DB_URL=jdbc:postgresql://localhost:5432/dt_outage
DB_USERNAME=dt_outage_app
DB_PASSWORD=changeme
ENTRA_ISSUER_URI=https://login.microsoftonline.com/<tenant-id>/v2.0
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Required for the first production administrator; remove after initial provisioning if desired.
BOOTSTRAP_SUPERADMIN_OID=

